@model InventoryManagementSystem.Models.Stock

<h2>Edit Stock</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="IngredientName"></label>
        <input asp-for="IngredientName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="StockUnit"></label>
        <input asp-for="StockUnit" class="form-control" type="number" />
    </div>
    <div class="form-group">
        <label asp-for="Date"></label>
        <input asp-for="Date" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
