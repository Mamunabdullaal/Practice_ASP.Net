@model IEnumerable<InventoryManagementSystem.Models.DatewiseProduction>

@{
    ViewData["Title"] = "Datewise Production";
}

<h2>Datewise Production</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Production</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Item Name</th>
            <th>Production</th>
            <th>Stock</th>
            <th>Sell</th>
            <th>Waste</th>
            <th>Left Over</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                <td>@item.ItemName</td>
                <td>@item.Production</td>
                <td>@item.Stock</td>
                <td>@item.Sell</td>
                <td>@item.Waste</td>
                <td>@item.LeftOver</td>
                <td>
                    <a asp-action="Details" asp-route-prodID="@item.ProdID" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-prodID="@item.ProdID" class="btn btn-warning btn-sm">Edit</a>
                    <form asp-action="Delete" asp-route-prodID="@item.ProdID" method="post" style="display:inline">
                        <input type="hidden" name="prodID" value="@item.ProdID" />
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
