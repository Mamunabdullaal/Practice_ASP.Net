@model InventoryManagementSystem.Models.ItemRecipe

@{
    ViewData["Title"] = "Delete Recipe";
}

<h2>Delete Recipe</h2>

<h4>Are you sure you want to delete this recipe?</h4>

<div>
    <dl class="row">
        <dt class="col-sm-2">Item Name</dt>
        <dd class="col-sm-10">@Model.ItemName</dd>

        <dt class="col-sm-2">Ingredient Name</dt>
        <dd class="col-sm-10">@Model.IngredientName</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ItemRecipeID" />
    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure?');">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
