@model InventoryManagementSystem.Models.ItemRecipe

@{
    ViewData["Title"] = "Add Item Recipe";
}

<h2>Add Item Recipe</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="ItemName"></label>
        <input asp-for="ItemName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="IngredientName"></label>
        <input asp-for="IngredientName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="ProductionQuantity"></label>
        <input asp-for="ProductionQuantity" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="QuantityGmPerPc"></label>
        <input asp-for="QuantityGmPerPc" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="QuantityPcPerPc"></label>
        <input asp-for="QuantityPcPerPc" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
