@model Dictionary<string, int>

<!DOCTYPE html>
<html lang="en">
<head>
    <title>HR Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: white;
            margin: 20px;
        }

        .dashboard {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .card {
            background: #1e1e1e;
            padding: 15px;
            border-radius: 10px;
            text-align: center;
            width: 200px;
            box-shadow: 2px 2px 10px rgba(255, 255, 255, 0.2);
            cursor: pointer;
        }

            .card:hover {
                background-color: #333;
            }

        .upload-form {
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <h1>HR Dashboard</h1>

    <form method="post" enctype="multipart/form-data" asp-action="UploadExcel" class="upload-form">
        <input type="file" name="file" required />
        <button type="submit">Upload & Process</button>
    </form>

    @if (Model.Count > 0)
    {
        <div class="dashboard">
            @foreach (var sheet in Model)
            {
                <div class="card" onclick="location.href='@Url.Action("ViewSheetData", "Home", new { sheetName = sheet.Key })'">
                    <h3>@sheet.Key</h3>
                    <p><strong>@sheet.Value</strong> Records</p>
                </div>
            }
        </div>
    }
    else
    {
        <p>No data available. Please upload an Excel file.</p>
    }
</body>
</html>
